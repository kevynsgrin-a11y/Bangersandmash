---
import Layout from '../layouts/Layout.astro';
import recipes from '../data/recipes.json';

const title = "Bangers & Mash — 92 English Heritage Recipes";
const description = "92 of England's best-loved heritage recipes with metric quantities, timings and oven temperatures in Celsius, Fahrenheit, fan and gas marks.";

// Eager load the first 6 recipes as featured
const featuredRecipes = recipes.slice(0, 6);
---
<Layout title={title} description={description}>
  <section class="hero wrap" style="text-align: center; padding: 4rem 0;">
    <h2>Discover the Taste of Heritage</h2>
    <p style="font-size: 1.25rem; max-width: 800px; margin: 0 auto 2rem;">{description}</p>
    <a href="/recipes" class="btn" style="background: var(--primary); color: #fff; padding: 0.75rem 1.5rem; border-radius: 4px; font-weight: 600;">Browse All Recipes</a>
  </section>

  <section class="wrap">
    <h2 class="sec">Featured Recipes</h2>
    <ul class="grid">
      {featuredRecipes.map((recipe, index) => (
        <li class="card">
          <a class="tt" href={`/recipe/${recipe.slug}`}>
            <div class="ph">
              <img 
                src={`/images/recipes/${recipe.slug}.webp`} 
                alt={recipe.title} 
                loading={index < 2 ? "eager" : "lazy"} 
                fetchpriority={index < 2 ? "high" : "auto"}
                decoding="async" 
              />
            </div>
          </a>
          <div class="bd">
            <p class="meta">{recipe.category}</p>
            <h3><a class="tt" href={`/recipe/${recipe.slug}`}>{recipe.title}</a></h3>
            <p>{recipe.blurb || recipe.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap" style="margin-top: 4rem;">
    <h2 class="sec">Browse by Collection</h2>
    <ul class="chips">
      <li><a href="/recipes">All 92</a></li>
      <li><a href="/collections/breakfast">Breakfast & Brunch</a></li>
      <li><a href="/collections/roasts">The Sunday Roast</a></li>
      <li><a href="/collections/pies">Pies & Savoury Puddings</a></li>
      <li><a href="/collections/pub">Pub Classics</a></li>
      <li><a href="/collections/seafood">Fish & Seafood</a></li>
      <li><a href="/collections/soups">Soups & Starters</a></li>
      <li><a href="/collections/sides">Sides & Sauces</a></li>
      <li><a href="/collections/baking">Baking & Afternoon Tea</a></li>
      <li><a href="/collections/desserts">Puddings & Desserts</a></li>
    </ul>
  </section>
</Layout>
