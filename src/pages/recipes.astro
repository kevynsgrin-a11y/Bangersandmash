---
import Layout from '../layouts/Layout.astro';
import recipes from '../data/recipes.json';

const title = "All Recipes - Bangers & Mash";
const description = "Browse all 92 authentic English heritage recipes.";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": recipes.map((recipe, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://bangersandmash.uk/recipe/${recipe.slug}`
  }))
};
---
<Layout title={title} description={description} canonical="https://bangersandmash.uk/recipes">
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <section class="wrap">
    <h1>All Recipes</h1>
    
    <div aria-live="polite" class="sr-only" style="margin-bottom: 1rem; color: var(--primary); font-weight: 600;">
      Showing {recipes.length} recipes
    </div>

    <ul class="chips" aria-label="Recipe categories">
      <li><a href="/recipes" aria-current="page">All 92</a></li>
      <li><a href="/collections/breakfast">Breakfast & Brunch</a></li>
      <li><a href="/collections/roasts">The Sunday Roast</a></li>
      <li><a href="/collections/pies">Pies & Savoury Puddings</a></li>
      <li><a href="/collections/pub">Pub Classics</a></li>
      <li><a href="/collections/baking">Baking & Afternoon Tea</a></li>
    </ul>

    <ul class="grid">
      {recipes.map((recipe, index) => (
        <li class="card">
          <a class="tt" href={`/recipe/${recipe.slug}`}>
            <div class="ph">
              <img 
                src={`/images/recipes/${recipe.slug}.webp`} 
                alt={recipe.title} 
                loading={index < 4 ? "eager" : "lazy"} 
                fetchpriority={index < 4 ? "high" : "auto"}
                decoding="async" 
              />
            </div>
          </a>
          <div class="bd">
            <p class="meta">{recipe.category}</p>
            <h3><a class="tt" href={`/recipe/${recipe.slug}`}>{recipe.title}</a></h3>
            <p>{recipe.blurb || recipe.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
